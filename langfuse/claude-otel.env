# Claude Code の OTel トレースを Collector に送るための環境変数
# ホストの claude 関数（.zsh/40-tools.zsh）と claude-sandbox（docker --env-file）の両方が読む
# 送信先（OTEL_EXPORTER_OTLP_TRACES_ENDPOINT）とリポジトリ名（OTEL_RESOURCE_ATTRIBUTES）は起動側が設定する
# docker の --env-file でも読めるよう、KEY=VALUE の形で書く（引用符・空白・変数展開は使わない）
CLAUDE_CODE_ENABLE_TELEMETRY=1
CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_LOG_USER_PROMPTS=1
OTEL_LOG_ASSISTANT_RESPONSES=1
