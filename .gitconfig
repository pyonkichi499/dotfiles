# 個人用GitHub設定（特定ディレクトリ配下で有効）
[includeIf "gitdir:/home/hiroshi/work/private_github/"]
	path = ~/.gitconfig-personal

# dotfiles ディレクトリ配下でも個人用設定を読み込む
[includeIf "gitdir:/home/hiroshi/dotfiles/"]
    path = ~/.gitconfig-personal

# [user]
# 	email = terauchi.hiroshi@cloud-ace.jp
# 	name = terauchi hiroshi
# 	signingkey = hoge
# [credential]
#     helper = store --file ~/.git-credentials

[color]
    diff = auto
    status = auto
    branch = auto
    ui = true

[alias]
    lol = log --oneline --graph
    loa = log --oneline --graph --all
    st = status -sb

[core]
	excludesfile = /Users/terauchi.hiroshi/.gitignore
	quotepath = false
	editor = cursor --wait
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
[credential "https://source.developers.google.com"]
	helper = gcloud.sh
[http]
	cookiefile = /Users/terauchi.hiroshi/.gitcookies
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[init]
	defaultBranch = main
