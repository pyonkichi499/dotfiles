[user]
	email = terauchi.hiroshi@cloud-ace.jp
	name = terauchi hiroshi
	signingkey = 2F0D81F32A9C1678
[credential]
    helper = store --file ~/.git-credentials

[color]
    diff = auto
    status = auto
    branch = auto
    ui = true

[alias]
    lol = log --oneline --graph
    loa = log --oneline --graph --all
    st = status -sb

[core]
	excludesfile = /Users/terauchi.hiroshi/.gitignore
	quotepath = false
	editor = cursor --wait
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
[credential "https://source.developers.google.com"]
	helper = gcloud.sh
[http]
	cookiefile = /Users/terauchi.hiroshi/.gitcookies
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[init]
	defaultBranch = main
